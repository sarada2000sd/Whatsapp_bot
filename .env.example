# Required for AI replies. Create a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Model listed in Google's Gemini API documentation
GEMINI_MODEL=gemini-3.8-flash

# Use digits only including country code; no +, spaces, or dashes.
# Example format for Sri Lanka: 947XXXXXXXX
PAIRING_NUMBER=

# Railway volume mount should be /app/data
AUTH_DIR=/app/data/auth

# Start empty. Bot logs group IDs it sees, but does not process unapproved groups.
# After finding your target group ID in Railway logs, add it here.
TARGET_GROUP_IDS=

# Keep true during initial testing; suggestions are logged but not sent.
# Set false only after checking logs and informing group members.
DRY_RUN=true

# smart = local candidate filter + Gemini decides; mention = only name/trigger mentions and questions
REPLY_MODE=smart
BOT_NAME=Sarada

# Safety and cost controls
MIN_CANDIDATE_LENGTH=12
CONTEXT_MESSAGES=6
REPLY_COOLDOWN_SECONDS=90
MAX_AI_CALLS_PER_GROUP_PER_HOUR=12
MAX_REPLIES_PER_GROUP_PER_HOUR=4
MAX_REPLY_LENGTH=500
